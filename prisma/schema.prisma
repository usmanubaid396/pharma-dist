datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(BOOKER)
  region    String
  createdAt DateTime @default(now())
}

model Medicine {
  id       String   @id @default(uuid())
  name     String
  category String
  stock    Int      @default(0)
  price    Float
  batch    String
  expiry   DateTime
  orders   OrderItem[]
}

model Order {
  id        String      @id @default(uuid())
  client    String
  booker    String
  region    String
  total     Float
  status    OrderStatus @default(PENDING)
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  quantity   Int
  price      Float
}

enum Role {
  ADMIN
  REGIONAL_MANAGER
  SALES_MANAGER
  BOOKER
  MED_REP
}

enum OrderStatus {
  PENDING
  APPROVED
  DISPATCHED
  DELIVERED
}

