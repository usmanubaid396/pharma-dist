datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  REGIONAL_MANAGER
  SALES_MANAGER
  ORDER_BOOKER
  MEDICAL_REP
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  APPROVED_BY_SM
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum CustomerType {
  RETAIL_PHARMACY
  WHOLESALER
  HOSPITAL
  CLINIC
}

model User {
  id           String      @id @default(cuid())
  name         String?
  email        String      @unique
  phone        String?     @unique
  passwordHash String?
  image        String?
  role         UserRole    @default(ORDER_BOOKER)
  status       UserStatus  @default(PENDING_APPROVAL)
  
  regionId     String?
  region       Region?     @relation(fields: [regionId], references: [id])
  territoryId  String?
  territory    Territory?  @relation(fields: [territoryId], references: [id])

  clientProfile ClientProfile?
  ordersBooked  Order[]          @relation("BookerOrders")
  ordersApproved Order[]         @relation("ApprovedOrders")
  visits        DailyCallReport[]
  auditLogs     AuditLog[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Region {
  id          String      @id @default(cuid())
  name        String      @unique
  users       User[]
  territories Territory[]
  createdAt   DateTime    @default(now())
}

model Territory {
  id          String      @id @default(cuid())
  name        String
  regionId    String
  region      Region      @relation(fields: [regionId], references: [id])
  users       User[]
  clients     ClientProfile[]
  doctors     Doctor[]
  createdAt   DateTime    @default(now())
}

model ClientProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyName     String
  proprietorName   String
  drapLicenseNo    String       @unique
  ntn              String?
  address          String
  customerType     CustomerType @default(RETAIL_PHARMACY)
  creditLimit      Decimal      @default(0.00) @db.Decimal(12, 2)
  currentBalance   Decimal      @default(0.00) @db.Decimal(12, 2)
  assignedBookerId String?
  territoryId      String?
  territory        Territory?   @relation(fields: [territoryId], references: [id])
  orders           Order[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  itemCode    String      @unique
  brandName   String
  genericName String
  dosageForm  String
  strength    String
  packSize    String
  tradePrice  Decimal     @db.Decimal(10, 2)
  mrp         Decimal     @db.Decimal(10, 2)
  isActive    Boolean     @default(true)
  batches     Batch[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model Batch {
  id              String      @id @default(cuid())
  batchNo         String      @unique
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  expiryDate      DateTime
  quantityInStock Int
  isActive        Boolean     @default(true)
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
}

model Doctor {
  id            String            @id @default(cuid())
  name          String
  specialty     String
  clinicAddress String
  territoryId   String
  territory     Territory         @relation(fields: [territoryId], references: [id])
  dcrReports    DailyCallReport[]
  createdAt     DateTime          @default(now())
}

model Order {
  id             String        @id @default(cuid())
  orderNo        String        @unique
  clientId       String
  client         ClientProfile @relation(fields: [clientId], references: [id])
  bookerId       String
  booker         User          @relation("BookerOrders", fields: [bookerId], references: [id])
  approvedById   String?
  approvedBy     User?         @relation("ApprovedOrders", fields: [approvedById], references: [id])
  status         OrderStatus   @default(SUBMITTED)
  totalAmount    Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  netAmount      Decimal       @db.Decimal(12, 2)
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  batchId    String?
  batch      Batch?   @relation(fields: [batchId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
}

model DailyCallReport {
  id            String    @id @default(cuid())
  medRepId      String
  medRep        User      @relation(fields: [medRepId], references: [id])
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id])
  visitDate     DateTime  @default(now())
  productsShown String
  sampleGiven   String?
  feedback      String?
  createdAt     DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  newValue   Json?
  createdAt  DateTime @default(now())
}
